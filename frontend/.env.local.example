# ============================================================
# RAG frontend (Next.js) - environment configuration
# ============================================================
# Copy to `.env.local`. All three variables are SERVER-SIDE only: none is
# exposed to the browser (no NEXT_PUBLIC_ prefix), and the access token lives in
# an httpOnly cookie that only these server routes can read.
# Next.js reads this file at START-UP: restart `npm run dev` after any change.
#
# Full guide: ../docs/ENVIRONMENT.md   Setup order: ../docs/LOCAL_SETUP.md
# ============================================================

# REQUIRED. Where the same-origin /api/rag proxy forwards browser requests to the
# RAG API. The proxy adds the IAM bearer token from the cookie, so the browser
# never sees it. Local Docker publishes the API on host port 8088.
#   local dev : http://127.0.0.1:8088/api/v1
#   production: the API's internal or public URL, ending in /api/v1
RAG_API_URL=http://127.0.0.1:8088/api/v1

# REQUIRED. Server-to-server address of the IAM *gateway* (NOT the auth-service).
# Used for sign-in, session refresh, invitations and connected accounts.
# Local dev : http://localhost:3301
# In Docker : http://gateway:3000 (an internal hostname the browser cannot reach)
AUTH_GATEWAY_URL=http://localhost:3301

# OPTIONAL locally (defaults to AUTH_GATEWAY_URL), REQUIRED in production when
# AUTH_GATEWAY_URL is an internal hostname: the gateway origin as the BROWSER
# reaches it. Social-login and "connect account" redirects send the user's
# browser here, so it must be publicly reachable, and it must also be listed in
# IAM's CORS_ORIGINS and be the origin registered in each OAuth provider's
# redirect URI (<origin>/api/auth/social/<provider>/callback).
# AUTH_GATEWAY_PUBLIC_URL=http://localhost:3301
