# Copy this file to secrets/app.env and fill in real values. secrets/app.env is gitignored — never
# commit it. See secrets/README.md for the full mechanism this feeds into
# (docs/DEPLOYMENT.md §8, docs/BUGS.md item 26).
#
# Plain KEY=value lines, same as .env — this file is mounted as ONE Docker secret
# (/run/secrets/app_env) and sourced directly by scripts/docker_secrets_entrypoint.sh. Production's
# real .env should omit every key below entirely (if both set the same variable, this file wins).

# --- Database / cache ---
# Owner connection migrate uses for schema DDL + creating the rag_app role (docs/DEPLOYMENT.md §4).
MIGRATION_DATABASE_URL=postgresql://<owner-user>:<owner-password>@postgres:5432/<database>
# Password migrate sets on the restricted rag_app role — generate a real one, don't reuse the owner's.
APP_DB_PASSWORD=REPLACE_ME
# The app's own connection, as the restricted role.
DATABASE_URL=postgresql://rag_app:<APP_DB_PASSWORD's value>@postgres:5432/<database>
# Must match the `postgres` service's actual superuser password (secrets/postgres_password.txt) —
# only read by the `backup` service (PGPASSWORD), since `postgres` itself uses
# POSTGRES_PASSWORD_FILE natively and never goes through this file.
POSTGRES_PASSWORD=REPLACE_ME
REDIS_URL=redis://redis:6379/0

# --- Auth / crypto ---
JWT_SECRET=REPLACE_ME
IAM_CLIENT_SECRET=REPLACE_ME
IAM_INTROSPECTION_API_KEY=REPLACE_ME
FILE_UPLOAD_HMAC_SECRET=REPLACE_ME
# Fernet key(s) protecting every stored connector credential — arguably the single most sensitive
# value in this file.
CONNECTOR_CREDENTIAL_KEYS=REPLACE_ME
CONNECTOR_RENDER_TOKEN=REPLACE_ME

# --- LLM providers ---
GOOGLE_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME

# --- Tool / integration keys ---
SERPER_API_KEY=REPLACE_ME
TAVILY_API_KEY=REPLACE_ME
OPENWEATHER_API_KEY=REPLACE_ME
NEWSAPI_API_KEY=REPLACE_ME
UPLOAD_SERVICE_API_KEY=REPLACE_ME
LANGCHAIN_API_KEY=REPLACE_ME
