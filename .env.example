# ============================================================
# langchain-knoledgebase-rag - Environment configuration
# ============================================================
# Copy to `.env` and fill in real values. `.env` is gitignored and must
# never be committed. Every variable below is read by a pydantic-settings
# class under packages/config/*.py (defaults shown are the code defaults
# unless a line says "recommended").
#
# Legend used in the comments:
#   REQUIRED     no code default - the app fails to start without it
#   RECOMMENDED  has a default, but the value shown is what you should use
#   OPTIONAL     safe to leave unset
#
# Full guide: docs/ENVIRONMENT.md   Setup order: docs/LOCAL_SETUP.md
# Provider keys you must supply yourself: docs/PROVIDER_VALUES.md
# Check this file against the other services: python scripts/preflight_env.py
# ============================================================

##############################################################
# Application - packages/config/app.py (AppSettings)
##############################################################
# Name shown in the API docs and logs.
APP_NAME=EasyDev AI Platform
# Version string reported by the API.
APP_VERSION=1.0.0
# Environment label: development | test | staging | production
APP_ENV=development
# Verbose error behaviour. Never true in production.
DEBUG=false
# A conversation with no activity for this many days is swept as expired
# by the cleanup job. Default 30.
# SESSION_EXPIRY_DAYS=30

##############################################################
# API server - packages/config/api.py (APISettings)
##############################################################
# Interface and port uvicorn binds to INSIDE the container.
# docker-compose.yml publishes the API on host port 8088.
HOST=0.0.0.0
PORT=8000

# Browser origins allowed to call this API cross-origin (comma-separated).
# Must include every frontend origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sliding-window request cap per tenant (per IP when there is no tenant),
# requests per 60 seconds. 0 disables the limit.
RATE_LIMIT_REQUESTS_PER_MINUTE=300

# These four exist on APISettings but packages/api/app.py hardcodes
# /docs, /redoc, /openapi.json and /api/v1, so setting them has no effect yet.
# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json
# API_PREFIX=/api/v1

##############################################################
# Authentication (IAM) - packages/config/api.py, packages/config/iam.py
##############################################################
# RECOMMENDED true in every real environment.
#   true : every route except /api/v1/health*, /api/v1/auth/refresh, the API
#          docs and CORS preflight needs a valid IAM bearer token. No or bad
#          token = 401, IAM/gateway unreachable = 503. Tenant and user come
#          from the verified token; X-Tenant-ID / X-User-ID headers are ignored.
#   false: legacy behaviour - anonymous callers get a default tenant (dev only).
# With it on, only the frontend (through its /api/rag proxy) sends tokens, so
# curl, the CLI and the /docs "Try it out" button get 401.
AUTH_REQUIRED=false

# IAM role codes (comma-separated) allowed to create agents, tool definitions
# and prompts. Only enforced when AUTH_REQUIRED=true.
ADMIN_ROLES=super_admin,admin,tenant_admin

# REQUIRED. The IAM *gateway* base URL (NOT the auth-service). Every request is
# verified with GET {IAM_BASE_URL}/api/auth/me. In Docker on Windows/macOS use
# http://host.docker.internal:3301 to reach the gateway on the host.
IAM_BASE_URL=http://localhost:3301

# OPTIONAL and UNUSED today: reserved for verifying RS256 tokens locally.
IAM_JWKS_BASE_URL=

# REQUIRED to start (no code default) but only read by IAM flows this app does
# not use yet: a placeholder value is fine.
#   IAM_CLIENT_ID / IAM_CLIENT_SECRET : credentials for IAM's client_credentials
#                                       service token
#   IAM_INTROSPECTION_API_KEY         : sent as x-api-key to IAM's session
#                                       introspection endpoint; set it to IAM's
#                                       own IAM_INTROSPECTION_API_KEY value
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
IAM_INTROSPECTION_API_KEY=

# Seconds per IAM request, retries on transient failures, and TLS verification
# (set IAM_VERIFY_SSL=false only against a local self-signed certificate).
IAM_TIMEOUT=30
IAM_MAX_RETRIES=3
IAM_VERIFY_SSL=true

# REQUIRED to start, but LEGACY: sessions are IAM-issued tokens and are not
# verified with this. Use a random 32+ character value.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Seed value of the dynamic "enable_rbac" feature flag: turns on
# permission-code checks (require_permission / require_role) on routes that
# use them. Separate from AUTH_REQUIRED. Editable live on the Feature Flags page.
ENABLE_RBAC=false

##############################################################
# Database - packages/config/database.py (DatabaseSettings)
##############################################################
# REQUIRED. Postgres connection string; the server needs the pgvector extension
# (the docker-compose.yml image has it). Inside Docker use the service name:
#   postgresql://user:password@postgres:5432/dbname
DATABASE_URL=postgresql://user:password@postgres:5432/dbname

# Used only to initialise the Postgres container on its FIRST start (and by its
# healthcheck). Keep consistent with DATABASE_URL; changing them later does not
# change an existing data volume.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# Connection pool overrides (defaults shown).
# POOL_SIZE=10
# MAX_OVERFLOW=20
# POOL_TIMEOUT=30
# ECHO=false            # log every SQL statement

##############################################################
# Redis - packages/config/redis.py (RedisSettings)
##############################################################
# REQUIRED. Job queue, rate limiting and caches.
REDIS_URL=redis://redis:6379/0
# DEFAULT_TTL=3600      # default cache lifetime in seconds

##############################################################
# Queue / worker - packages/config/queue.py (QueueSettings)
##############################################################
# Prefix for queue keys, so several stacks can share one Redis. Default easydev.
QUEUE_PREFIX=easydev
# CONCURRENCY=5         # jobs a worker runs in parallel
# MAX_RETRIES=3         # attempts per failed job
# RETRY_DELAY=5         # seconds between attempts

##############################################################
# LLM - packages/config/embedding.py (AISettings)
##############################################################
# Which provider answers chat: google | openai | anthropic | groq.
LLM_PROVIDER=google
# Model id for that provider (code default: gemini-pro).
LLM_MODEL=gemini-2.5-flash
# Sampling temperature and the cap on generated tokens per answer.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# Stream tokens to the client (SSE).
LLM_STREAMING=true
# OPTIONAL sampling controls; unset = the provider's own default.
# LLM_TOP_K=
# LLM_TOP_P=

# Circuit breaker around the LLM provider: after this many consecutive
# failures calls fail fast, and one trial call is allowed after the reset time.
# LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_BREAKER_RESET_SECONDS=30

# Set the key for LLM_PROVIDER, and for EMBEDDING_PROVIDER if it differs.
# Google:    https://aistudio.google.com  (Get API key)
# OpenAI / Anthropic / Groq: the provider console.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

##############################################################
# Embeddings, vector store and retrieval - packages/config/rag.py (RAGSettings)
##############################################################
# Provider and model used to embed documents and queries.
# Providers: google | openai | huggingface (Anthropic has no embeddings).
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/embedding-001
# Vector size. 1536 is one of gemini-embedding-001's documented truncation
# points and is under pgvector's 2000-dimension index limit. It must match the
# database column; changing it means re-embedding every document.
EMBEDDING_DIMENSIONS=1536
# Self-imposed caps on embedding calls, kept under the provider's own limit
# (Gemini free tier: 100/min) so queued ingestion waits instead of hitting 429.
# EMBEDDING_RATE_LIMIT_REQUESTS_PER_MINUTE=90
# EMBEDDING_RATE_LIMIT_TOKENS_PER_MINUTE=30000

# Where embeddings are stored: pgvector | chroma.
# RECOMMENDED pgvector (same Postgres, no extra service). The code default is
# chroma, so set this explicitly. faiss/qdrant are not implemented.
VECTOR_STORE_BACKEND=pgvector
# Collection / namespace name inside the store.
VECTOR_COLLECTION_NAME=langchain
# chroma only: on-disk store, or a `chroma run` server (needed when the API and
# the worker both use Chroma, because the embedded client is single-process).
CHROMA_DIRECTORY=./storage/chroma
# CHROMA_SERVER_HOST=
# CHROMA_SERVER_PORT=

# Document splitting: characters per chunk and overlap between adjacent chunks.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval mode (vector + keyword). Default hybrid.
# RETRIEVAL_STRATEGY=hybrid
# Chunks passed to the answer step after reranking. Default 5.
# RAG_MAX_RESULTS=5
# Maximum tokens of retrieved context sent to the LLM. Default 4000.
# RAG_CONTEXT_TOKEN_BUDGET=4000
# Cut-off on the reranker's RAW score (can be negative). The top chunk is always
# kept so an answer never lacks a citation. Default 0.0.
# RAG_MIN_RELEVANCE_SCORE=0.0
# The weekly job re-embeds current documents not indexed for this many days.
# REINDEX_STALE_AFTER_DAYS=90

##############################################################
# Feature flags - packages/config/features.py (FeatureSettings)
##############################################################
# Seed values for the live Feature Flags page; changes made there take effect
# within about 30 seconds without a redeploy. All default true (ENABLE_RBAC is above).
ENABLE_RAG=true              # retrieval-augmented answers
ENABLE_TOOLS=true            # agent tool calling
ENABLE_MEMORY=true           # conversation memory
ENABLE_STREAMING=true        # SSE streaming
ENABLE_RERANKING=true        # cross-encoder reranking (downloads a ~90 MB model on first use; false skips it)
ENABLE_QUERY_REWRITE=true    # query rewriting before retrieval
ENABLE_WEB_SEARCH=true       # web search tool (needs SERPER_API_KEY or TAVILY_API_KEY)
ENABLE_WEATHER=true          # weather tool (needs OPENWEATHER_API_KEY)
ENABLE_NEWS=true             # news tool (needs NEWSAPI_API_KEY)
ENABLE_CALCULATOR=true       # safe calculator tool

##############################################################
# Tool providers - packages/config/tools.py (ToolSettings)
##############################################################
# Web search: set one of these if ENABLE_WEB_SEARCH=true.
# serper.dev
SERPER_API_KEY=
# tavily.com
TAVILY_API_KEY=
# REQUIRED to start (no code default) even if the tool is unused: a placeholder
# is fine when the matching ENABLE_* flag is false.
# openweathermap.org
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
# newsapi.org
NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org

##############################################################
# Storage - packages/config/storage.py (StorageSettings)
##############################################################
# Local file handling limits. No required variables; defaults shown.
# PROVIDER=local             # local | s3 | azure | minio
# UPLOAD_DIRECTORY=storage/uploads
# TEMP_DIRECTORY=storage/temp
# MAX_FILE_SIZE=52428800     # largest accepted upload, bytes (50 MB)
# SIGNED_URL_EXPIRY=3600     # signed URL lifetime, seconds

##############################################################
# Upload service - packages/config/upload_service.py (UploadServiceSettings)
##############################################################
# REQUIRED. Base URL of the EasyDev file-upload-service (NOT LangSmith).
# Docker on Windows/macOS: http://host.docker.internal:4005
UPLOAD_SERVICE_URL=http://localhost:4005
# Seconds per call (1-300).
UPLOAD_SERVICE_TIMEOUT=30
# Sent as x-api-key. The upload service does not check it today.
UPLOAD_SERVICE_API_KEY=
# Signed download URL lifetime in seconds (minimum 60).
UPLOAD_SIGNED_URL_EXPIRY=3600
# false only for a local self-signed certificate.
UPLOAD_SERVICE_VERIFY_SSL=true
# REQUIRED for uploads while the upload service runs with GATEWAY_AUTH_REQUIRED=true
# (its default): the shared secret used to sign every request (X-Gateway-Hmac).
# Must equal the upload service's GATEWAY_INTERNAL_SECRET (32+ chars). Without it
# POST /documents fails with "Missing gateway signature".
FILE_UPLOAD_HMAC_SECRET=
# Role presented to the upload service in the signed identity: user | admin.
# RAG is a trusted backend acting for tenants it already authorised.
UPLOAD_SERVICE_ROLE=admin

##############################################################
# Logging - packages/config/logging.py (LoggingSettings)
##############################################################
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Structured JSON logs; each line carries request_id and, with tracing, trace_id.
LOG_JSON=true

##############################################################
# Notification - packages/config/notification.py (env_prefix="NOTIFICATION_")
##############################################################
# NOT wired into the app: the RAG code never calls notification-service (only IAM
# sends email). Kept so the class's env contract is documented.
# NOTIFICATION_BASE_URL=
# NOTIFICATION_API_KEY=
# NOTIFICATION_TIMEOUT=30
# NOTIFICATION_VERIFY_SSL=true

##############################################################
# LangSmith tracing - packages/config/observability.py (ObservabilitySettings)
##############################################################
# Sends LLM/chain traces to LangSmith. Only active when BOTH the flag is true AND
# a real LANGCHAIN_API_KEY is set; keep it false unless you have a key.
# (The code default is false.)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AI-Agent-Platform

##############################################################
# OpenTelemetry tracing - packages/config/observability.py
##############################################################
# Distributed tracing (HTTP request -> graph nodes -> outbound calls). Needs an
# OTLP collector: docker-compose.yml's `jaeger` service (profile "full") receives
# on 4317 and shows traces at http://localhost:16686.
OTEL_ENABLED=false
# OTLP gRPC collector address. Inside compose use jaeger:4317.
OTEL_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=easydev-ai-platform
