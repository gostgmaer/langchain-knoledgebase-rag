# syntax=docker/dockerfile:1.7
# Base image is overridable so a build can reuse the copy already in the local
# image store when Docker Hub's layer CDN is unreachable (this machine's
# recurring `tls: bad record MAC`): pin it to the local digest, e.g.
#   docker compose build --build-arg PYTHON_BASE=python:3.14-slim@sha256:<digest>
# (`docker image inspect python:3.14-slim --format '{{json .RepoDigests}}'`).
ARG PYTHON_BASE=python:3.14-slim
# ============================================================
# Stage 1 - Builder
# ============================================================
FROM ${PYTHON_BASE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
# Venv lives OUTSIDE /app on purpose: docker-compose.yml bind-mounts the
# source tree over /app for live code, which would hide an /app/.venv. The
# old workaround (an anonymous `/app/.venv` volume) silently kept serving
# the FIRST build's packages forever — Compose preserves anonymous volumes
# across container recreation, so a rebuild after a uv.lock bump never
# reached the running container (confirmed live: cryptography/pyjwt/
# oauthlib/pypdf were all behind uv.lock). /opt/venv can't be shadowed.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
# Download retries — see docker/Dockerfile's matching comment (this network
# intermittently corrupts downloads in transit).
ENV UV_HTTP_RETRIES=8

WORKDIR /app

RUN apt-get -o Acquire::Retries=8 update && apt-get -o Acquire::Retries=8 install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Installed from PyPI, not `COPY --from=ghcr.io/astral-sh/uv:latest` —
# this environment's network reliably reaches Docker Hub and PyPI but
# not ghcr.io (confirmed live: a plain `docker pull ghcr.io/...` fails
# identically with `tls: bad record MAC`, while docker.io/pypi.org
# pulls succeed), so routing uv's own install through ghcr.io was the
# actual build blocker, not anything about this image.
RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./

# Same cache mount as docker/Dockerfile, same target — BuildKit shares
# one cache across both images by default, so building this one after
# api reuses everything already downloaded (api and worker share the
# exact same dependency set) instead of re-fetching it a second time.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
    --locked \
    --no-dev

# ============================================================
# Runtime
# ============================================================
FROM ${PYTHON_BASE}

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# -m creates a real, owned /home/app — see docker/Dockerfile's matching
# comment: sentence-transformers' lazy model download needs a writable
# $HOME/.cache, which a plain `useradd -r` system account doesn't get.
RUN groupadd -r app && useradd -r -m -g app app \
 && install -d -o app -g app /home/app/.cache/huggingface

# --chown at COPY time, not a separate `RUN chown -R` afterwards — see
# docker/Dockerfile's matching comment: a metadata-only chown on files
# an earlier layer already materialized forces a full re-copy into the
# new layer, roughly doubling image size for nothing.
COPY --chown=app:app --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

COPY --chown=app:app . .

USER app

# arq's own built-in health check (docs/BUGS.md item 21) — reads the Redis
# key `record_health()` refreshes every `health_check_interval` (60s, see
# packages/worker/main.py), so this catches a worker that's still running
# but has silently stopped polling, not just a fully crashed process
# (which already triggers `restart: unless-stopped` on its own).
#
# --timeout=30s, not the first-draft 10s: `arq ... --check` itself imports
# packages.worker.main (and transitively the whole RAG/ML dependency chain
# — torch, transformers, etc.) before it ever reaches Redis, measured live
# at ~18s in this exact image — a 10s timeout made Docker report a
# genuinely healthy worker as `unhealthy` on every single check, forever
# (confirmed live: `docker inspect`'s health log showed "Health check
# exceeded timeout (10s)" on every attempt while the same command run
# directly, untimed, succeeded in ~18s). --start-period=30s for the same
# reason, so the first few checks during that heavy import don't count
# against --retries while the container is still legitimately starting.
HEALTHCHECK --interval=30s --timeout=30s --start-period=30s --retries=3 \
    CMD ["arq", "packages.worker.main.WorkerSettings", "--check"]

CMD ["python", "-m", "packages.worker.main"]